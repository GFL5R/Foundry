        "twelve_questions": {
            "title": "Character Creation — 12 Questions",
            "intro": "Answer twelve questions to define your character. Choose a character type to begin.",
            "type_human": "Human (Commander)",
            "type_tdoll": "T-Doll",
            "human_intro": "You are a human commander working for B.R.I.E.F., a PMC that hunts bounties in a post-Collapse world. These twelve questions will define who you are, where you came from, and what drives you forward.",
            "tdoll_intro": "You are a Tactical Doll — an autonomous android built for combat. Assigned to a commander, you operate in the field as weapon and partner. These twelve questions will define your frame, your history, and who you are becoming.",
            "next": "Next",
            "prev": "Back",
            "choose": "Choose...",
            "generate": "Create Character",
            "summary": "Summary",
            "ready": "All required fields are complete. Ready to create character.",
            "drop_discipline": "Drop a discipline here",
            "starting_technique_title": "Starting Technique (Rank 1)",
            "drop_starting_technique": "Drop a starting technique here",
            "drop_module": "Drop a module here",
            "drop_advantage": "Drop an advantage here",
            "drop_disadvantage": "Drop a disadvantage here",
            "drop_passion": "Drop a passion here",
            "drop_anxiety": "Drop an anxiety here",
            "goal_placeholder": "What drives this character?",
            "nav": {
                "setup": "Setup",
                "origin": "Origin",
                "training": "Training",
                "traits": "Traits",
                "worldview": "Worldview",
                "identity": "Identity"
            },
            "human": {
                "q1": {
                    "title": "Question 1: Where are you from?",
                    "flavor": "The post-Collapse world is fractured into rival power blocs. Your nationality shaped your worldview, your training, and the way you approach problems."
                },
                "q2": {
                    "title": "Question 2: What is your background?",
                    "flavor": "Before you signed on with B.R.I.E.F., you had a life. Your background defines the skills and mindset you bring to the field."
                },
                "q3": {
                    "title": "Question 3: What path have you chosen?",
                    "flavor": "Your discipline is your combat doctrine — the framework that determines how you operate in the field. Drag a discipline and one rank 1 technique from that discipline."
                },
                "q4": {
                    "title": "Question 4: How do you stand out in your field?",
                    "flavor": "Every operator has something that sets them apart. What advantage gives you an edge over others? Drag an advantage from the compendium."
                },
                "q5": {
                    "title": "Question 5: What holds you back the most?",
                    "flavor": "Nobody is perfect. What flaw, limitation, or burden do you carry? Drag a disadvantage from the compendium."
                },
                "q6": {
                    "title": "Question 6: What sets you apart from other humans?",
                    "flavor": "Beyond your combat role, what personal obsession or hobby defines you? Drag a passion from the compendium."
                },
                "q7": {
                    "title": "Question 7: What do you fear the most?",
                    "flavor": "Fear drives decisions under pressure. What psychological trigger haunts you? Drag an anxiety from the compendium."
                },
                "q8": {
                    "title": "Question 8: How do you view Dolls?",
                    "flavor": "This is the defining question for a commander. Do you see your T-Doll as a person — a partner with agency and feelings? Or as a tool — a weapon system to be maintained and deployed?",
                    "option_person": "Person — They're people. (+5 Humanity)",
                    "option_tool": "Tool — They're equipment. (+1 Skill)",
                    "bonus_skill": "Choose a bonus skill"
                },
                "q9": {
                    "title": "Question 9: What do you fight for?",
                    "flavor": "Beyond survival and paychecks, what motivates you to keep going into the field?"
                },
                "q10": {
                    "title": "Question 10: What does your name mean?",
                    "flavor": "Names carry weight. Was yours inherited, earned, gifted, or taken?",
                    "placeholder": "The story behind your name..."
                },
                "q12": {
                    "flavor": "Every story ends. How do you see yours ending? Quiet retirement? Glorious last stand? Something classified?"
                }
            },
            "tdoll": {
                "q1": {
                    "title": "Question 1: Who made you, and what is your model number?",
                    "flavor": "Your manufacturer and frame model define your physical capabilities. Each frame was designed for a purpose — your approaches and starting skills come from your hardware."
                },
                "q2": {
                    "title": "Question 2: What weapon were you imprinted with?",
                    "flavor": "Your weapon imprint is hardwired into your fire control core. It defines your combat doctrine. Drag a discipline from the compendium."
                },
                "q3": {
                    "title": "Question 3: What upgrades set you apart?",
                    "flavor": "Factory stock gets you killed. What modifications and software upgrades have been installed? Drag modules from the compendium."
                },
                "q4": {
                    "title": "Question 4: What is your greatest achievement so far?",
                    "flavor": "You once exceeded your design parameters. What did you accomplish? Drag an advantage from the compendium."
                },
                "q5": {
                    "title": "Question 5: What holds you back the most?",
                    "flavor": "Hardware limitations or behavioral quirks that affect your performance. Drag a disadvantage from the compendium."
                },
                "q6": {
                    "title": "Question 6: What makes you different?",
                    "flavor": "Despite official claims, Dolls develop personal quirks and interests. What hobby or fixation proves you're more than programming? Drag a passion from the compendium."
                },
                "q7": {
                    "title": "Question 7: What are you most afraid of?",
                    "flavor": "Officially, Dolls don't experience fear. But your neural cloud processes something that looks exactly like it. Drag an anxiety from the compendium."
                },
                "q8": {
                    "title": "Question 8: When did you meet your Commander?",
                    "flavor": "The bond between a Doll and their Commander is the core of your operational life. Were you factory-fresh? Secondhand? Rescued from a scrapyard?",
                    "label": "How you met",
                    "placeholder": "Describe the circumstances of your assignment..."
                },
                "q9": {
                    "title": "Question 9: What do you want for yourself?",
                    "flavor": "Beyond your mission parameters, what do you desire? Freedom? Recognition? Answers about your own design?"
                },
                "q10": {
                    "title": "Question 10: How were you named?",
                    "flavor": "Your name carries mechanical implications. A human name makes you relatable; a callsign earns reputation; a weapon designation defines you by your imprint; a strange name confuses everyone.",
                    "option_human": "Human Name (+5 Humanity)",
                    "option_callsign": "Callsign / Nickname (+5 Fame)",
                    "option_weapon": "Weapon Designation (+1 Firearms, −5 Humanity)",
                    "option_weird": "Weird Name (−5 Fame)"
                },
                "q12": {
                    "flavor": "Dolls aren't immortal, just durable. How does your service end? Civilian life? Field death? Scrapped? Something else?"
                }
            },
            "q11": {
                "title": "Question 11: What is your name?",
                "flavor": "The name that will appear on mission reports and be spoken by those who know you.",
                "placeholder": "Enter character name"
            },
            "q12": {
                "title": "Question 12: How will your story end?",
                "placeholder": "How do you see your story ending?"
            }
        },
